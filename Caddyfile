{
	admin off
}

# Caddy is the single authenticated ingress for FormFlow.
# Passwords live only in data/private/caddy/jury-users.caddy (ignored by Git).
:8080 {
	basic_auth bcrypt "FormFlow Jury" {
		import /etc/caddy/jury-users.caddy
	}

	# Media shares the same HTTP Basic protection as the app and docs.
	handle_path /film/* {
		root * /srv/formflow-films
		header Cache-Control "private, max-age=3600"
		file_server
	}

	handle {
		reverse_proxy api:8000 {
			# Do not forward shared credentials into Python.
			header_up -Authorization
			transport http {
				dial_timeout 10s
				response_header_timeout 750s
			}
		}
	}
}
