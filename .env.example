# Listening port on the VPS loopback interface only.
FORMFLOW_HOST_PORT=18171
# Files are inspected in memory / temporary storage only.
MAX_UPLOAD_MB=15
# Intentionally disabled until the COI JSON contract and local AI pipeline are implemented.

# Optional development-only provider; do not use in COI competition submission.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-vl-30b-a3b-instruct
OPENROUTER_TEMPERATURE=0
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional; set only for a model supporting the OpenRouter reasoning parameter.
OPENROUTER_REASONING_EFFORT=
